{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tdtrworksheet",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tdtrworksheet",
      "database_id": "4fad38bc-03ec-4d5a-8ccc-81b4b75ea55d"
    }
  ],
  "routes": [
    { "pattern": "tdtrws.simetry.digital", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
